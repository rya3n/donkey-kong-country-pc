{
  "schema_version": 1,
  "rom_profile": "usa-rev1",
  "scope": "All twenty-seven Kongo Jungle, Monkey Mines, Vine Valley, Gorilla Glacier, Kremkroc Industries Inc. and Chimp Caverns stage hints; original names and clues preserved",
  "messages": [
    {
      "id": "dialogue_en.3c0f35", "world": "kongo-jungle", "stage": "Jungle Hijinxs",
      "offset": "0x3C0F35", "bytes": 61, "max_line": 29, "balanced_padding": true,
      "lines": ["Em Jungle Hijinxs,", "fique nas copas para", "ganhar vidas extras."]
    },
    {
      "id": "dialogue_en.3c0f72", "world": "kongo-jungle", "stage": "Ropey Rampage",
      "offset": "0x3C0F72", "bytes": 70, "max_line": 29, "balanced_padding": true,
      "lines": ["A farra de Ropey Rampage", "fica entre uma pedra", "e algo bem duro!"]
    },
    {
      "id": "dialogue_en.3c0fb8", "world": "kongo-jungle", "stage": "Barrel Cannon Canyon",
      "offset": "0x3C0FB8", "bytes": 68, "max_line": 29, "balanced_padding": true,
      "lines": ["Um salto de fé basta", "para achar Winky em", "Barrel Cannon Canyon."]
    },
    {
      "id": "dialogue_en.3c0ffc", "world": "kongo-jungle", "stage": "Reptile Rumble",
      "offset": "0x3C0FFC", "bytes": 50, "max_line": 29, "balanced_padding": true,
      "lines": ["Há bananas no fosso de cobras", "de Reptile Rumble!"]
    },
    {
      "id": "dialogue_en.3c102e", "world": "kongo-jungle", "stage": "Coral Capers",
      "offset": "0x3C102E", "bytes": 70, "max_line": 29, "balanced_padding": true,
      "lines": ["O astuto Croctopus guarda", "seu tesouro num canto", "de Coral Capers."]
    },
    {
      "id": "dialogue_en.3c1074", "world": "monkey-mines", "stage": "Bouncy Bonanza",
      "offset": "0x3C1074", "bytes": 50, "max_line": 29, "balanced_padding": true,
      "lines": ["Use o pneu:", "rinoceronte dourado", "em Bouncy Bonanza."]
    },
    {
      "id": "dialogue_en.3c10a6", "world": "monkey-mines", "stage": "Stop & Go Station",
      "offset": "0x3C10A6", "bytes": 51, "max_line": 29, "balanced_padding": true,
      "lines": ["As bananas de", "Stop & Go Station", "mostram o caminho!"]
    },
    {
      "id": "dialogue_en.3c10d9", "world": "monkey-mines", "stage": "Mine Cart Carnage",
      "offset": "0x3C10D9", "bytes": 60, "max_line": 29, "balanced_padding": true,
      "lines": ["Evite Mine Cart Carnage", "e pule cedo para", "ganhar a vida extra."]
    },
    {
      "id": "dialogue_en.3c1115", "world": "monkey-mines", "stage": "Millstone Mayhem",
      "offset": "0x3C1115", "bytes": 70, "max_line": 29, "balanced_padding": true,
      "lines": ["Role um pneu para seguir", "pelo caminho certo", "em Millstone Mayhem!"]
    },
    {
      "id": "dialogue_en.3c1565", "world": "vine-valley", "stage": "Orang-utan Gang",
      "offset": "0x3C1565", "bytes": 78, "max_line": 30, "balanced_padding": true,
      "lines": ["Em Orang-utan Gang, siga o", "barril final abaixo para", "um barril de risadas!"]
    },
    {
      "id": "dialogue_en.3c15b3", "world": "vine-valley", "stage": "Tree Top Town",
      "offset": "0x3C15B3", "bytes": 60, "max_line": 29, "balanced_padding": true,
      "lines": ["Uma só banana", "basta para abrir", "o segredo de Tree Top Town."]
    },
    {
      "id": "dialogue_en.3c15ef", "world": "vine-valley", "stage": "Temple Tempest",
      "offset": "0x3C15EF", "bytes": 69, "max_line": 29, "balanced_padding": true,
      "lines": ["Caia dentro com as bananas", "e se prepare pra festa", "em Temple Tempest!"]
    },
    {
      "id": "dialogue_en.3c115b", "world": "gorilla-glacier", "stage": "Snow Barrel Blast",
      "offset": "0x3C115B", "bytes": 85, "max_line": 30, "balanced_padding": true,
      "lines": ["Em Snow Barrel Blast, descer", "nem sempre tira você do jogo;", "pode fazer você ir adiante."]
    },
    {
      "id": "dialogue_en.3c11b0", "world": "gorilla-glacier", "stage": "Croctopus Chase",
      "offset": "0x3C11B0", "bytes": 79, "max_line": 29, "balanced_padding": true,
      "lines": ["Em Croctopus Chase, há um", "jeito certo e um jeito errado", "pra passar pelos barris."]
    },
    {
      "id": "dialogue_en.3c11ff", "world": "gorilla-glacier", "stage": "Ice Age Alley",
      "offset": "0x3C11FF", "bytes": 69, "max_line": 29, "balanced_padding": true,
      "lines": ["Em Ice Age Alley,", "aves do mesmo bando voam", "juntas pra dar asas a você."]
    },
    {
      "id": "dialogue_en.3c1244", "world": "gorilla-glacier", "stage": "Slipslide Ride",
      "offset": "0x3C1244", "bytes": 68, "max_line": 29, "balanced_padding": true,
      "lines": ["Pular bem no saltador vai", "deslizar você ao sucesso em", "Slipslide Ride!"]
    },
    {
      "id": "dialogue_en.3c1288", "world": "gorilla-glacier", "stage": "Torchlight Trouble",
      "offset": "0x3C1288", "bytes": 76, "max_line": 29, "balanced_padding": true,
      "lines": ["O TNT rende um bom par de", "estouros de parede em parede", "em Torchlight Trouble."]
    },
    {
      "id": "dialogue_en.3c12d4", "world": "kremkroc-industries", "stage": "Elevator Antics",
      "offset": "0x3C12D4", "bytes": 69, "max_line": 29, "balanced_padding": true,
      "lines": ["Em Elevator Antics, você", "deve subir mais alto", "que um ninho de vespas!"]
    },
    {
      "id": "dialogue_en.3c1319", "world": "kremkroc-industries", "stage": "Trick Track Trek",
      "offset": "0x3C1319", "bytes": 60, "max_line": 29, "balanced_padding": true,
      "lines": ["Em Trick Track Trek, os", "gêmeos Gnawty sabem", "de um segredo!"]
    },
    {
      "id": "dialogue_en.3c1355", "world": "kremkroc-industries", "stage": "Mine Cart Madness",
      "offset": "0x3C1355", "bytes": 64, "max_line": 29, "balanced_padding": true,
      "lines": ["Em Mine Cart Madness,", "você está a 3 quiques", "da terra dos prêmios."]
    },
    {
      "id": "dialogue_en.3c1395", "world": "kremkroc-industries", "stage": "Poison Pond",
      "offset": "0x3C1395", "bytes": 82, "max_line": 30, "balanced_padding": true,
      "lines": ["Ao entrar em Poison Pond,", "ir pela direita nem sempre", "é o caminho certo pra ponta."]
    },
    {
      "id": "dialogue_en.3c13e7", "world": "kremkroc-industries", "stage": "Blackout Basement",
      "offset": "0x3C13E7", "bytes": 78, "max_line": 29, "balanced_padding": true,
      "lines": ["Blackout Basement pode fazer", "você achar que afunda, mas", "você termina lá no céu!"]
    },
    {
      "id": "dialogue_en.3c1435", "world": "chimp-caverns", "stage": "Manic Mincers",
      "offset": "0x3C1435", "bytes": 44, "max_line": 29, "balanced_padding": true,
      "lines": ["Deixe Diddy segurar o TNT", "em Manic Mincers."]
    },
    {
      "id": "dialogue_en.3c1461", "world": "chimp-caverns", "stage": "Misty Mine",
      "offset": "0x3C1461", "bytes": 60, "max_line": 29, "balanced_padding": true,
      "lines": ["Use bastante corda e", "você se surpreenderá", "lá em Misty Mine."]
    },
    {
      "id": "dialogue_en.3c149d", "world": "chimp-caverns", "stage": "Loopy Lights",
      "offset": "0x3C149D", "bytes": 53, "max_line": 29, "balanced_padding": true,
      "lines": ["Em Loopy Lights, o barril", "do abutre joga você longe."]
    },
    {
      "id": "dialogue_en.3c14d2", "world": "chimp-caverns", "stage": "Platform Perils",
      "offset": "0x3C14D2", "bytes": 77, "max_line": 29, "balanced_padding": true,
      "lines": ["O abutre de Platform Perils", "sabe que por vezes é melhor", "descer para a terra."]
    },
    {
      "id": "dialogue_en.3c151f", "world": "chimp-caverns", "stage": "Tanked Up Trouble",
      "offset": "0x3C151F", "bytes": 70, "max_line": 29, "balanced_padding": true,
      "lines": ["Você terá Tanked Up Trouble", "se tiver o tanque cheio", "e sem ter aonde ir!"]
    }
  ]
}
