  "messages": [
    {
      "id": "dialogue_en.3c315b",
      "offset": "0x3C315B", "bytes": 46, "max_line": 29,
      "lines": ["Olá!  Sou a Candy Kong!", "Você pode salvar aqui!"]
    },
    {
      "id": "dialogue_en.3c3189",
      "offset": "0x3C3189", "bytes": 72, "max_line": 29,
      "lines": [" Para salvar seu jogo atual, ", "pule no meu barril giratório", "de salvamento!"]
    },
    {
      "id": "dialogue_en.3c31d1", "offset": "0x3C31D1", "bytes": 38, "max_line": 29,
      "balanced_padding": true,
      "lines": ["Oi, gente!", "Tem algo bom para salvar?"]
    },
    {
      "id": "dialogue_en.3c31f7", "offset": "0x3C31F7", "bytes": 38, "max_line": 29,
      "balanced_padding": true,
      "lines": ["Ajudo vocês,", "macacos, a salvar o jogo?"]
    },
    {
      "id": "dialogue_en.3c321d", "offset": "0x3C321D", "bytes": 49, "max_line": 29,
      "balanced_padding": true,
      "lines": ["Que tal uma voltinha", "no meu barril", "de salvamento?"]
    },
    {
      "id": "dialogue_en.3c324e", "offset": "0x3C324E", "bytes": 69, "max_line": 29,
      "balanced_padding": true,
      "lines": ["Ei, Honey Kong!", "Boa hora para salvar", "seu progresso até aqui!"]
    },
    {
      "id": "dialogue_en.3c3293", "offset": "0x3C3293", "bytes": 80, "max_line": 29,
      "balanced_padding": true,
      "lines": ["Deve ter dado trabalho", "chegar até aqui!", "Que tal salvar seu jogo?"]
    },
    {
      "id": "dialogue_en.3c32e3", "offset": "0x3C32E3", "bytes": 81, "max_line": 29,
      "balanced_padding": true,
      "lines": ["Uau! Vocês chegaram longe!", "Salvem seu jogo agora,", "enquanto podem!"]
    }
  ]
}
